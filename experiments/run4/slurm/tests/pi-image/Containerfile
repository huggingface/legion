# pi-worker-node22: Node 22 + the Pi CLI for flock `harness: pi` workers (built by ../pi-image.slurm).
# Python is NOT in the image: flock-worker runs from the ro-mounted venv + uv Python (common.sh).
# Base and Pi version as in flock/Dockerfile.worker.
FROM node:22.23.3-bookworm-slim@sha256:c3de60bf2f9dd0ac6370e6117950ff62d6e339527e7472301c9c78a017978392
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates git ripgrep procps \
 && rm -rf /var/lib/apt/lists/*
RUN npm install -g @earendil-works/pi-coding-agent@1.2.0 && npm cache clean --force
ENV FLOCK_PI_CLI=/usr/local/bin/pi PI_OFFLINE=1 PI_SKIP_VERSION_CHECK=1 PI_TELEMETRY=0
