# Names only. Operator supplies values in the cluster secrets file (mode 600).
# One HF_TOKEN: read/write only on the experiment bucket and cmpatino/chatbot-swarm.
# Controller/workers also hold dataset-write permission. Validate child isolation in the Pi image.
HF_TOKEN=
OPENAI_API_KEY=
CHATBOT_BOARD_INVITE=
CHATBOT_WORLD_TOKEN=
# The world's /admin secret (`python -m flock.world knobs|set|pause|resume`): read by the world and the
# controller, unset for workers. Use a value unrelated to CHATBOT_WORLD_TOKEN. Empty: /admin is 403.
FLOCK_WORLD_ADMIN_TOKEN=
FLOCK_TOKEN=
