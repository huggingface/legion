# Copy to runs/run4/run.env, chmod 600. Values here are non-secret.
RUN3_NAMESPACE=cmpatino
RUN3_BUCKET=hf://buckets/cmpatino/eliza-swarm
RUN3_VARIANT=jobs
# The experiment folder the controller copies and launches: run4, hierarchy or voting.
RUN3_EXPERIMENT=run4
CHATBOT_BOARD_URL=https://cmpatino-msgboard-chatbot.hf.space
CHATBOT_CHANNEL=general
CHATBOT_REPO=cmpatino/chatbot-swarm
MODEL_WORKER=MODEL_WORKER
# Two vLLM servers = two B300 jobs (slurm/ops/serve-dsv41-flash-run4.slurm, --array=0-1; it writes
# <run>/hosts/vllm-<i>.host and logs the line to paste). Pi hashes each agent to one URL (rendezvous,
# stable). A restarted server gets a new node name: update this line, re-render + `flock update`, and
# relaunch the workers whose agents used the dead URL (Pi keeps its URL until its worker restarts).
OPENAI_BASE_URLS=http://ip-10-53-0-1:8000/v1,http://ip-10-53-0-2:8000/v1
# Optional: load_guard derives <base>/metrics (the router serves /metrics without a key).
#OPENAI_METRICS_URLS=http://ip-10-53-0-1:8000/metrics,http://ip-10-53-0-2:8000/metrics
# Board budget (docs/comms.md): one token bucket per worker shared by the feed poller and every
# comms tool call; workers read it at start. 0.1/s x 25 workers = 2.5 req/s ceiling at 300 agents
# from the cluster's single NAT IP. Retune per wave from the smoke's 429 counts.
FLOCK_COMMS_RATE=0.1
FLOCK_COMMS_BURST=5
# Per-agent comms tool calls (refused locally, no request sent): defaults 0.1/s, burst 10.
#FLOCK_COMMS_AGENT_RATE=0.1
#FLOCK_COMMS_AGENT_BURST=10
# Feed poll cycle per agent; the run-4 default is 300 s.
#FLOCK_COMMS_POLL_CYCLE_S=300
# First launch only: how long `flock apply` waits for the world (a requeued controller never waits).
WORLD_WAIT_S=1800
# World crash handling: only crashes within WORLD_STABLE_S of the start count toward 5; past that the
# job sleeps WORLD_RETRY_MIN_S, doubling to WORLD_RETRY_MAX_S, and starts again (never ends).
#WORLD_STABLE_S=600
#WORLD_RETRY_MIN_S=300
#WORLD_RETRY_MAX_S=1800
# Optional non-preemptible placement for the two singletons, when the cluster has such a partition or
# QOS. Unset = the #SBATCH header (hopper-cpu, Spot). Slurm reads the header at submit time, so these
# are used by the sbatch command line, not by the job: `. run.env` first, then the sbatch line in
# world.sbatch / controller.sbatch (it expands them when set).
#WORLD_PARTITION=
#WORLD_QOS=
#CTL_PARTITION=
#CTL_QOS=
WORLD_RESTORE_ATTEMPTS=5
WORLD_RESTORE_BACKOFF_S=30
CHATBOT_RUN_SLOTS=26
# Worker job size (controller.sbatch FLOCK_SLURM_CPUS / FLOCK_SLURM_MEM; defaults 4 / 7G). Read at
# every controller start, so a requeue applies it to the workers launched from then on. hopper-cpu
# MaxMemPerCPU=2000: mem / cpus must stay <= 2000 MB (the controller dies otherwise); <= 28 CPU / 54G.
#WORKER_CPUS=6
#WORKER_MEM=11G
RUN4_HOLD_WARN_AFTER=3
# Calibrate on the live Pi smoke; growth above 100 stays blocked on overload.
RUN4_MAX_REQUEST_SECONDS=15
CTL_REPO=/fsx/carlos_patino/prj-eliza/flock-run4-ctl
CTL_VENV=/fsx/carlos_patino/prj-eliza/venv-run4-ctl
WORLD_REPO=/fsx/carlos_patino/prj-eliza/flock-run4-world
WORLD_VENV=/fsx/carlos_patino/prj-eliza/venv-run4-world
WORKER_REPO=/fsx/carlos_patino/prj-eliza/flock-run4-worker
WORKER_VENV=/fsx/carlos_patino/prj-eliza/venv-run4-worker
CONTAINER_IMAGE_agent=/fsx/carlos_patino/prj-eliza/images/pi-worker-node22.sqsh
# The world also uses this image: it needs git for native Hub PR refs.
CONTAINER_IMAGE=/fsx/carlos_patino/prj-eliza/images/pi-worker-node22.sqsh
