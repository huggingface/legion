# Cluster settings to add to the run.env `flock init` writes (mode 600). Values here are non-secret.
RUN3_NAMESPACE=cmpatino
RUN3_BUCKET=hf://buckets/cmpatino/eliza-swarm
# The 30-min smoke: the loop ends after 30 min / 100 rounds (spec.yaml loop.while).
#LOOP_UNTIL=30m
#LOOP_MAX_ROUNDS=100
# The board's base URL, path prefix included: one Space hosts several boards under /boards/<id>
# (hierarchy-v5, voting-v6, teams; see the experiment's README). The invite in secrets.env must be
# created inside this same board: tokens are per board.
CHATBOT_BOARD_URL=https://huggingfaceswarms-chatbot-msgboards.hf.space/boards/BOARD_ID
CHATBOT_CHANNEL=general
CHATBOT_REPO=cmpatino/chatbot-swarm
MODEL_WORKER=MODEL_WORKER
# Two vLLM servers = two B300 jobs (slurm/ops/serve-dsv41-flash-run4.slurm, --array=0-1; it writes
# <run>/hosts/vllm-<i>.host and logs the line to paste). Pi hashes each agent to one URL (rendezvous,
# stable). A restarted server gets a new node name: update this line, `flock update --env run.env`, and
# relaunch the workers whose agents used the dead URL (Pi keeps its URL until its worker restarts).
OPENAI_BASE_URLS=http://ip-10-53-0-1:8000/v1,http://ip-10-53-0-2:8000/v1
# The controller scrapes <base>/metrics of each URL (providers.vllm.metrics) for the ramp's hold_if.
# Board budget (docs/comms.md): one token bucket per worker shared by the feed poller and every
# comms tool call; workers read it at start. 0.1/s x 25 workers = 2.5 req/s ceiling at 300 agents
# from the cluster's single NAT IP. Retune per wave from the smoke's 429 counts.
FLOCK_COMMS_RATE=0.1
FLOCK_COMMS_BURST=5
# Per-agent comms tool calls (refused locally, no request sent): defaults 0.1/s, burst 10.
#FLOCK_COMMS_AGENT_RATE=0.1
#FLOCK_COMMS_AGENT_BURST=10
# Feed poll cycle per agent; the run-4 default is 300 s.
#FLOCK_COMMS_POLL_CYCLE_S=300
# First launch only: how long `flock launch` waits for the world (a requeued controller never waits).
WORLD_WAIT_S=1800
# World crash handling: only crashes within WORLD_STABLE_S of the start count toward 5; past that the
# job sleeps WORLD_RETRY_MIN_S, doubling to WORLD_RETRY_MAX_S, and starts again (never ends).
#WORLD_STABLE_S=600
#WORLD_RETRY_MIN_S=300
#WORLD_RETRY_MAX_S=1800
# Optional non-preemptible placement for the two singletons, when the cluster has such a partition or
# QOS. Unset = the cluster profile's SLURM_PARTITION (else the cluster default). Slurm reads the header at submit time, so these
# are used by the sbatch command line, not by the job: `. run.env` first, then the sbatch line in
# world.sbatch / controller.sbatch (it expands them when set).
#WORLD_PARTITION=
#WORLD_QOS=
#CTL_PARTITION=
#CTL_QOS=
WORLD_RESTORE_ATTEMPTS=5
WORLD_RESTORE_BACKOFF_S=30
CHATBOT_RUN_SLOTS=26
# Worker job size (spec.yaml compute.cpus / mem; defaults 4 / 7G). Read when the spec is applied
# (`flock launch`/`flock update --env run.env`); the stored spec wins over the env afterwards. With the
# profile's SLURM_MAX_MEM_PER_CPU_MB, mem / cpus must stay under it (the controller dies otherwise);
# with FLOCK_SLURM_MAX_CPUS/_MEM, under those.
#WORKER_CPUS=6
#WORKER_MEM=11G
# Interviewer slot size (interviewer experiment, spec.yaml compute.types.interviewer).
#RUN3_INTERVIEWER_CPUS=2
#RUN3_INTERVIEWER_MEM=3800M
# replicas_ramp.hold_if.request_s; calibrate on the live Pi smoke: growth above 100 stays blocked on overload.
RUN4_MAX_REQUEST_SECONDS=15
CTL_REPO=<project>/flock-run4-ctl
CTL_VENV=<project>/venv-run4-ctl
WORLD_REPO=<project>/flock-run4-world
WORLD_VENV=<project>/venv-run4-world
WORKER_REPO=<project>/flock-run4-worker
WORKER_VENV=<project>/venv-run4-worker
CONTAINER_IMAGE_agent=<project>/images/pi-worker-node22.sqsh
# The world also uses this image: it needs git for native Hub PR refs.
CONTAINER_IMAGE=<project>/images/pi-worker-node22.sqsh
