# worker.env.example: the per-launch env file worker.sbatch sources (fact sheet §2, row "worker").
# Matches flock origin/run3 fc22785 (src/flock/controller/slurm.py worker_env / env_file_text).
#
# Written by the controller's Slurm jobs client (FLOCK_COMPUTE=slurm) into
#   $FLOCK_SLURM_LAUNCH_DIR/<WORKER_ID>-<WORKER_INCARNATION>.env     (mode 600, written atomically)
# then passed as: sbatch ... $FLOCK_SLURM_WORKER_SCRIPT <that file>.
#
# Format: one KEY=value per line (sorted), sourced with `set -a; . FILE; set +a`. Values with
# shell metacharacters are single-quoted ('...'; a literal ' is written '\''). Lines starting
# with # are comments. The file holds NO secret values: the first comment lines name the secrets
# the worker expects, and worker.sbatch takes them from secrets/secrets.env (sourced BEFORE this
# file by common.sh): FLOCK_TOKEN, HF_TOKEN, plus the spec's (OPENAI_API_KEY, CHATBOT_BOARD_INVITE,
# ...). FLOCK_WORLD_TOKEN falls back to secrets.env's CHATBOT_WORLD_TOKEN.
#
# flock worker env (written by the controller; no secret values).
# Secrets this worker expects from the cluster's secrets file: FLOCK_TOKEN HF_TOKEN OPENAI_API_KEY CHATBOT_BOARD_INVITE FLOCK_WORLD_TOKEN
BUCKET=hf://buckets/<ns>/<bucket>            # spec.bucket: agent state goes to <BUCKET>/<swarm>/<type>/<agent>/{workdir,sessions,harness}; required
DEADLINE=2026-10-26T12:34:56+00:00           # ISO 8601: lifetime 24h + up to 4h jitter from launch; the worker drains DRAIN_WINDOW before it
DRAIN_WINDOW=10m                             # the type's drain window
FLOCK_CTL_HOST_FILE=/fsx/carlos_patino/prj-eliza/runs/<RUN>/hosts/controller.host   # FLOCK_SLURM_HOST_FILE; <run>/hosts is mounted ro in the worker's container (re-read by flock-worker: pending upstream)
FLOCK_LLM_HOME=/tmp/flock/<WORKER_ID>/llm    # slurm.py WORK_BASE; worker.sbatch OVERRIDES it with /work/flock/agents/llm (container root, no worker id)
FLOCK_SECRETS_FILE=/fsx/carlos_patino/prj-eliza/secrets/secrets.env   # FLOCK_SLURM_SECRETS_FILE: path only (common.sh sources its fixed path)
FLOCK_URL='http://${CTL_HOST}:7860'          # with a host file: the template; worker.sbatch exports CTL_HOST from <run>/hosts/controller.host, flock-worker expands it (expand_env)
FLOCK_VENV=/fsx/carlos_patino/prj-eliza/venv # FLOCK_SLURM_VENV: informational (worker.sbatch uses common.sh VENV)
PYTHONUNBUFFERED=1
RUN=<RUN>                                    # FLOCK_SLURM_RUN, else the launch dir's parent name; worker.sbatch reads it to find the run dir
SWARM=run3                                   # the swarm name (run3 or run3-<CHATBOT_RUN>)
TYPE=agent                                   # agent | agent-think | interviewer
WORK_ROOT=/tmp/flock/<WORKER_ID>/work        # slurm.py WORK_BASE; worker.sbatch OVERRIDES it with /work/flock/agents/work (container root, no worker id: Pi sessions resume across relaunches)
WORKER_ID=run3-agent-w0001                   # the slot id <swarm>-<type>-wNNNN; also the sbatch job name
WORKER_INCARNATION=0123456789abcdef0123456789abcdef   # uuid4 hex; binds polls and heartbeats to this job (a stale incarnation gets 409 and exits)
# --- the type's env (TypeSpec.env) and other non-secret controller env, written verbatim when present
# --- optional worker knobs (worker/main.py from_env); worker.sbatch sets the defaults shown when absent
# SYNC_INTERVAL=180                          # seconds between bucket pushes per agent
# HEARTBEAT_INTERVAL=30                      # seconds between heartbeats (slot unknown after 90 s, dead after 180 s)
# LOG_LEVEL=INFO                             # python logging level of flock-worker
# --- set by worker.sbatch / worker-inner.sh, not by the client
# HOME=/work/home HF_HOME=/work/hf TMPDIR=/work/tmp   # inside the container (no home mount; never ~/.cache/huggingface)
# CTL_HOST                                   # from <run>/hosts/controller.host
