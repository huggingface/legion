# run4, prepared 2026-10-27 from experiments/run4/slurm/run.env.example @ b32e9e3.
# Non-secret settings only (mode 600). Secrets: /fsx/carlos_patino/prj-eliza/secrets/secrets.env
# Lines marked TODO(Carlos) need a decision before any launch; nothing here has been launched.
RUN3_NAMESPACE=cmpatino
# Same bucket as run 3; world archive -> $RUN3_BUCKET/run4/world.tar.gz, controller state -> .../controller/run4.
# TODO(Carlos): confirm reusing hf://buckets/cmpatino/eliza-swarm for run 4 (vs a fresh bucket).
RUN3_BUCKET=hf://buckets/cmpatino/eliza-swarm
RUN3_VARIANT=jobs
# New dedicated run-4 board (run 3 used lvwerra-msgboard-demo / prj-chatbot-v2).
CHATBOT_BOARD_URL=https://cmpatino-msgboard-chatbot.hf.space
# TODO(Carlos): confirm channel (spec default "general"; the invite must join it and allow channel creation).
CHATBOT_CHANNEL=general
# TODO(Carlos): confirm target dataset (spec/README default).
CHATBOT_REPO=cmpatino/chatbot-swarm
# TODO(Carlos): model id served on the run-4 vLLM nodes (run 3: deepseek-ai/DeepSeek-V4.1-Flash-1017).
MODEL_WORKER=deepseek-ai/DeepSeek-V4.1-Flash-1017
# TODO(Carlos): the two run-4 vLLM servers (two separate Slurm jobs): fill in each job's node URL,
# comma-separated, no spaces; render.py turns this into provider base_urls (agents rendezvous-hashed by name).
# Both servers must serve MODEL_WORKER with the same OPENAI_API_KEY. Run 3's single node was
# http://ip-10-53-196-166:8000/v1 (that job has ended). Metrics URLs in the same order.
OPENAI_BASE_URLS=http://ip-10-53-196-166:8000/v1,http://ip-10-53-197-39:8000/v1
OPENAI_METRICS_URLS=http://ip-10-53-196-166:8000/metrics,http://ip-10-53-197-39:8000/metrics
WORLD_WAIT_S=1800
WORLD_RESTORE_ATTEMPTS=5
WORLD_RESTORE_BACKOFF_S=30
CHATBOT_RUN_SLOTS=26
RUN4_HOLD_WARN_AFTER=3
# Calibrate on the live Pi smoke; growth above 100 stays blocked on overload.
RUN4_MAX_REQUEST_SECONDS=15
# Per-role pins: prepare_roles.sh @ b32e9e3f4b495683f8ae760920816727d942cd0e, venvs link
# bin/python directly to cpython-3.12.14 (no cpython-3.12 symlink hop).
CTL_REPO=/fsx/carlos_patino/prj-eliza/flock-run4-ctl
CTL_VENV=/fsx/carlos_patino/prj-eliza/venv-run4-ctl
WORLD_REPO=/fsx/carlos_patino/prj-eliza/flock-run4-world
WORLD_VENV=/fsx/carlos_patino/prj-eliza/venv-run4-world
WORKER_REPO=/fsx/carlos_patino/prj-eliza/flock-run4-worker
WORKER_VENV=/fsx/carlos_patino/prj-eliza/venv-run4-worker
CONTAINER_IMAGE_agent=/fsx/carlos_patino/prj-eliza/images/pi-worker-node22.sqsh
# The world also uses this image: it needs git for native Hub PR refs.
CONTAINER_IMAGE=/fsx/carlos_patino/prj-eliza/images/pi-worker-node22.sqsh
# Board budget (flock-apex, msg 33738): worker token bucket shared by the poller and tool calls.
# 0.1/s x 25 workers = 2.5 req/s ceiling at 300 agents; retune per wave from the smoke's 429 counts.
FLOCK_COMMS_RATE=0.15
FLOCK_COMMS_BURST=5
# Waves schedule read by controller.sbatch (RUN3_WAVES, relative to <run>/experiment): smoke = wave 1 (5 agents);
# switch to waves.yaml at the re-anchor (then restart the controller or run waves.py by hand).
RUN3_WAVES=waves.yaml
# 08:21 UTC: PR pause switch (flock-apex 54fbf33): touch = paused, rm = unpaused, checked per call.
CHATBOT_PRS_PAUSED_FILE=/fsx/carlos_patino/prj-eliza/runs/run4/world/prs-paused
# 09:45 UTC: worker job size for NEW launches (controller.sbatch reads these from a fresh submit on; 2000 MB/CPU rule).
WORKER_CPUS=6
WORKER_MEM=11G
CHATBOT_HUB_WRITE_SLOTS=1
WS_SYNC_S=60
# 19:07Z sync exclusions beyond the 899e1aa defaults (flock-apex 34143): agents keep per-PR repo copies with .cache/huggingface download metadata
FLOCK_SYNC_EXCLUDE=.cache/
# 02:33Z planned USR1 drains hit the 20 s default with 100-200k-file workdirs (11/12 agents synced); the sbatch wrapper only waits, no hard kill
FLOCK_DRAIN_BUDGET_S=60
CHATBOT_MERGE_HUB_SLOTS=1
CHATBOT_GET_PR_DIFF_BYTES=60000
