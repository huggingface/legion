# run3 on Slurm: the shared, NON-SECRET settings every job of the run sources (set -a; . file).
# Copy to <RUN_DIR>/run3.env and edit. Secrets live in $SECRETS_FILE (mode 600), never here.
RUN=run3-smoke                                  # the run's name (RUN= in every worker env file)
RUNS=/fsx/run3/runs                             # one directory per run, on the shared disk
RUN_DIR=$RUNS/$RUN                              # host files, launch/, logs/, the rendered spec
REPO=/fsx/run3/flock                            # a checkout of huggingface/flock at the run's commit
VENV=/fsx/run3/venv                             # uv venv with the flock wheel [controller]
SECRETS_FILE=/fsx/run3/secrets.env              # mode 600; see secrets.env.example
SQSH=                                           # optional: an Enroot image (Containerfile); empty = venv on the node
# the bucket: agent state, controller state, world workspace, bundle. Never /fsx.
RUN3_BUCKET=hf://buckets/<ns>/<bucket>
CHATBOT_BUCKET=$RUN3_BUCKET/$RUN                # the world's best/ mirror and ws/ sync
FLOCK_STATE_URL=$RUN3_BUCKET/controller/$RUN    # the controller's SQLite + events
# the endpoint and the board (render.py reads these)
OPENAI_BASE_URLS=http://vllm-0:8000/v1          # comma-separated; reachable inside the cluster
MODEL_WORKER=<served model id>
CHATBOT_BOARD_URL=https://<board>
CHATBOT_CHANNEL=<channel>
CHATBOT_RUN=smoke                               # swarm run3-<CHATBOT_RUN>
RUN3_VARIANT=smoke                              # smoke (30-min loop) | selfhosted (48 h)
RUN3_WAVES=waves-smoke.yaml
# compute slurm: the controller's FLOCK_SLURM_* (the spec's compute block may override)
FLOCK_SLURM_PARTITION=hopper-cpu
FLOCK_SLURM_WORKER_SCRIPT=$REPO/experiments/run3/slurm/worker.sbatch
FLOCK_SLURM_LAUNCH_DIR=$RUN_DIR/launch
FLOCK_SLURM_LOG_DIR=$RUN_DIR/logs
FLOCK_SLURM_HOST_FILE=$RUN_DIR/hosts/controller.host   # hosts/ is mounted ro into worker containers
FLOCK_SLURM_SECRETS_FILE=$SECRETS_FILE
FLOCK_SLURM_VENV=$VENV
FLOCK_WORLD_HOST_FILE=$RUN_DIR/hosts/world.host
WORLD_PARALLEL=14                               # world.yaml runs.parallel (16 CPUs - 2)
# workers in the container (empty: bare venv on the node, paths in node-local /tmp)
FLOCK_SLURM_CONTAINER_IMAGE=$SQSH
FLOCK_SLURM_CONTAINER_ROOT=                     # /work with an image: /work/flock/<worker id>/{work,llm,home,hf,tmp}
