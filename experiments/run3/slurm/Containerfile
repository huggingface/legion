# run3 worker/world image for Enroot/Pyxis (no secrets baked in; no HOME needed).
# Build context: a directory holding the flock wheel (`uv build --wheel` -> dist/flock-*.whl);
# see README.md "Container image" for container-build / enroot import.
#   podman/docker/buildah:  build -f Containerfile -t run3-flock:<sha> <context with dist/>
#   enroot import -o /fsx/run3/images/run3-flock-<sha>.sqsh dockerd://run3-flock:<sha>
FROM python:3.12-slim

ARG HF_HUB_VERSION=2.2.0
ENV PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PATH=/opt/flock/bin:$PATH \
    WORK_ROOT=/work/agents FLOCK_LLM_HOME=/work/llm CHATBOT_WS=/work/ws \
    HOME=/work/home HF_HOME=/work/hf TMPDIR=/work/tmp FLOCK_HOMELESS_ROOT=/work

COPY dist/ /tmp/dist/
# /opt/flock: a venv with flock[controller] (the world server and the CLI) and the hf CLI;
# its bin/ has flock, flock-worker, flock-controller, flock-tool, hf and python
RUN python -m venv /opt/flock \
 && /opt/flock/bin/pip install "$(ls /tmp/dist/flock-*.whl)[controller]" "huggingface_hub==${HF_HUB_VERSION}" \
 && rm -rf /tmp/dist \
 && /opt/flock/bin/flock --help >/dev/null \
 && /opt/flock/bin/python -c "import flock.worker.main, flock.world.server, fastapi, uvicorn"
# /work: everything an agent, a harness or the world writes (the container's /tmp is a RAM
# tmpfs that counts against the job's memory). World-writable: Enroot maps the job's user.
RUN mkdir -p /work/agents /work/llm /work/ws /work/home /work/hf /work/tmp \
 && chmod -R 1777 /work
WORKDIR /work
CMD ["/opt/flock/bin/flock-worker"]
