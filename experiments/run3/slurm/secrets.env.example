# secrets.env: mode 600 on /fsx (chmod 600), sourced by every job of the run before it starts
# flock. Names only here; never commit values. The Slurm client never writes these anywhere.
FLOCK_TOKEN=            # the controller's API token (controller, workers, waves, CLI)
HF_TOKEN=               # bucket read/write (controller state, agent sync, world ws, bundle)
OPENAI_API_KEY=         # the vLLM key (any value when vLLM runs without --api-key)
CHATBOT_BOARD_INVITE=   # the board's multi-use agent invite
CHATBOT_WORLD_TOKEN=    # the world's shared secret (controller, world)
FLOCK_WORLD_TOKEN=      # the same value as CHATBOT_WORLD_TOKEN (workers and the world read this name)
