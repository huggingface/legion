# swarm-harness worker image: Node 22 (harness CLIs, pinned) + Python 3.12 (the worker).
# Build from the repo root: docker build -f Dockerfile.worker -t swarm-harness-worker .
FROM node:22-bookworm-slim

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates git ripgrep procps \
 && rm -rf /var/lib/apt/lists/*

# Harness versions are part of the contract: resume across workers needs the same CLI.
RUN npm install -g @anthropic-ai/claude-code@2.1.296 @openai/codex@0.162.1 \
 && npm cache clean --force

COPY --from=ghcr.io/astral-sh/uv:0.9.5 /uv /usr/local/bin/uv
ENV UV_PYTHON_INSTALL_DIR=/opt/python \
    UV_PROJECT_ENVIRONMENT=/opt/venv \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    PATH=/opt/venv/bin:$PATH

WORKDIR /opt/swarm-harness
COPY pyproject.toml uv.lock ./
COPY src ./src
RUN uv python install 3.12 \
 && uv sync --frozen --no-dev --extra worker --python 3.12 \
 && rm -rf /root/.cache/uv

# Fixed paths: restore puts files back at identical absolute paths on every worker.
# Jobs run as root, so Claude's bypassPermissions needs IS_SANDBOX=1. The adapter pins the
# npm CLI rather than the SDK's bundled binary.
ENV WORK_ROOT=/work/agents \
    CLAUDE_CONFIG_DIR=/state/claude \
    CODEX_HOME=/state/codex \
    IS_SANDBOX=1 \
    SWARM_HARNESS_CLAUDE_CLI=/usr/local/bin/claude \
    SWARM_HARNESS_CODEX_CLI=/usr/local/bin/codex \
    PYTHONUNBUFFERED=1

# Codex authenticates with an API key (never a copied OAuth auth.json).
RUN mkdir -p /work/agents /state/claude /state/codex \
 && printf '%s\n' '#!/bin/sh' 'set -e' \
    'if [ -n "$OPENAI_API_KEY" ]; then printenv OPENAI_API_KEY | codex login --with-api-key >/dev/null; fi' \
    'exec swarm-harness-worker "$@"' > /usr/local/bin/worker-entrypoint \
 && chmod +x /usr/local/bin/worker-entrypoint

WORKDIR /work
ENTRYPOINT ["/usr/local/bin/worker-entrypoint"]
